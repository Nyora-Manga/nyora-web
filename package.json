{
  "name": "nyora-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Nyora Web \u2014 production build (bundles web/ into dist/ for Cloudflare Pages).",
  "scripts": {
    "build": "node build.mjs",
    "fetch:ort": "node scripts/fetch-ort.mjs",
    "prerender:discover": "node scripts/prerender-discover.mjs",
    "check:rails": "node scripts/check-rails.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:reader": "node tests/local-reader.browser.mjs",
    "test:colorizer": "node tests/colorizer-worker.browser.mjs",
    "check:helper": "node scripts/check-helper.mjs",
    "test:desktop": "node tests/desktop-ui.browser.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "1.61.1"
  },
  "dependencies": {
    "@material/web": "^2.5.0"
  }
}
